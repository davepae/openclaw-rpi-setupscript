# OpenClaw Pi 5 build — settings shared by every script.
# Copy to config/settings.env and edit. Nothing secret goes in this file;
# secrets are prompted for or generated and land in ~/.openclaw/.env (mode 600).

# ---- Versions (pin; bump deliberately) --------------------------------------
OPENCLAW_VERSION="2026.10.8"          # npm version; git tag is v${OPENCLAW_VERSION}
NODE_VERSION="24.22.1"                # used by install-cli.sh; 26.12.1+ also supported
OPENCLAW_REPO="https://github.com/openclaw/openclaw"

# ---- Pi identity ------------------------------------------------------------
ADMIN_USER="pi"                       # your human admin account (has sudo)
OC_USER="openclaw_user"               # unprivileged agent account (no sudo)
TIMEZONE="America/Chicago"            # timedatectl list-timezones

# ---- Network ----------------------------------------------------------------
DNS_SERVERS="192.168.50.1"            # space-separated resolvers openclaw_user may reach (port 53)
EGRESS_ALLOW_HOSTS=""                 # space-separated "ip:port" (TCP) entries openclaw_user may reach on the LAN,
                                      # e.g. "192.168.50.10:8080 192.168.50.20:8080 192.168.50.20:3002" (LLM, SearXNG, Firecrawl).
                                      # A bare IP opens every port, including to builder's containers; avoid it.
TS_TAG_PI="tag:openclaw-pi"           # Tailscale tags (define them in config/tailnet-policy.hujson first)
TS_TAG_LAB="tag:openclaw-lab"
PI_TAILNET_NAME=""                    # MagicDNS name of the Pi, e.g. openclaw-pi.tailXXXX.ts.net (filled after Tailscale)

# ---- Models (onboarding) ----------------------------------------------------
# AUTH_CHOICE: anthropic | openai | custom
AUTH_CHOICE="custom"
CUSTOM_BASE_URL="https://openrouter.ai/api/v1"
CUSTOM_MODEL_ID="<provider/strong-model>"
CUSTOM_PROVIDER_ID="openrouter"
CUSTOM_COMPATIBILITY="openai"         # openai | openai-responses | anthropic
CUSTOM_IMAGE_INPUT="0"                # 1 only if the model accepts images (vision); else onboarding marks it text-only
PRIMARY_MODEL="<provider/strong-model>"   # agents.defaults.model.primary
PDF_MODEL="<provider/vision-model>"       # agents.defaults.pdfModel.primary (vision-capable)

# ---- Sandbox sizing (16 GB Pi; halve on 8 GB) ------------------------------
SANDBOX_MEMORY="3g"
SANDBOX_CPUS="2"
SANDBOX_PIDS="512"

# ---- Optional features ------------------------------------------------------
BUILD_BROWSER_IMAGE="0"               # 1 = build OpenClaw's sandbox browser image from a source checkout (flagged #4)
ENABLE_ELEVATED="0"                   # 1 = allow /elevated from the Control UI (webchat "*"; audit flags it CRITICAL)
LAB_SESSION_HOST="0"                  # 1 = lab exec node may host whole agent sessions (container-isolated)

# ---- Encrypted off-Pi backups (pi/95-backup-export.sh) ---------------------
BACKUP_AGE_RECIPIENT=""               # age PUBLIC key (age1...) from the machine that keeps the copies; empty = skip
BACKUP_EXPORT_DIR="/var/backups/openclaw-export"   # encrypted copies, readable by ADMIN_USER for rsync

# ---- Lab VM (separate x86 box) ---------------------------------------------
LAB_USER="oclab"                      # unprivileged lab account on the lab VM
LAB_EXEC_NODE_NAME="lab-exec"
LAB_DESKTOP_NODE_NAME="lab-desktop"
PI_TAILNET_IP=""                      # Pi 100.x address: the only tailnet IP lab egress allows (limit ports in tailnet policy)
LAB_DNS_SERVERS="192.168.60.1"        # resolvers the lab VM may reach (its own VLAN's pfSense address, or your LAN resolver without a VLAN)
